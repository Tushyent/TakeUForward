PORT=5000
MONGODB_URI=mongodb://localhost:27017/takeuforward_dev
MONGODB_DB_NAME=takeuforward_dev
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
CLIENT_URL=http://localhost:5173

# Observability
LOG_LEVEL=debug
SESSION_SECRET=my_super_secret_dev_session_key
ALLOW_TEST_SESSION=false
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_BUCKET_NAME=takeuforward-dev

# Email Notifications (Resend)
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=onboarding@resend.dev

# Gemini API Integration
GEMINI_API_KEY=your_gemini_api_key_here

# Web Push Notifications (VAPID)
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:your_email@domain.com

# Cron Jobs
CRON_SECRET=your_cron_secret_token_here

# Environment
NODE_ENV=development
