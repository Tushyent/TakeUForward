# ==============================================================================
# 🚀 TakeUForward Backend - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the server root.
# 2. Never commit your real `.env` file to version control.
# 3. Replace all bracketed placeholder values with your actual secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
# Set to 'production' on Render, 'development' locally
NODE_ENV=development
# The port the Express server will listen on
PORT=5000
# The URL of your frontend application (used for CORS and auth redirects)
CLIENT_URL=http://localhost:5173
# The domain restriction for Google OAuth (e.g., ssn.edu.in)
ALLOWED_EMAIL_DOMAIN=ssn.edu.in
# Only set to true in CI pipelines or test environments
ALLOW_TEST_SESSION=false
LOG_LEVEL=debug

# ------------------------------------------------------------------------------
# 2. MONGODB DATABASE
# ------------------------------------------------------------------------------
# Your local or Atlas MongoDB connection string
MONGODB_URI=mongodb://localhost:27017/takeuforward_dev
# The database name used for the application
MONGODB_DB_NAME=takeuforward_dev

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION (Google OAuth & Sessions)
# ------------------------------------------------------------------------------
# Session secret used for signing cookies. Use a long, random string in production.
SESSION_SECRET=[GENERATE_A_SECURE_RANDOM_STRING_HERE]
# Your Google Cloud Console OAuth Client ID
GOOGLE_CLIENT_ID=[YOUR_GOOGLE_CLIENT_ID_HERE]
# Your Google Cloud Console OAuth Client Secret
GOOGLE_CLIENT_SECRET=[YOUR_GOOGLE_CLIENT_SECRET_HERE]
# The callback URL matching your Google Cloud Console config
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ------------------------------------------------------------------------------
# 4. AWS S3 / SUPABASE STORAGE
# ------------------------------------------------------------------------------
# Used for storing and fetching PDF notes, images, and user avatars
AWS_REGION=[YOUR_AWS_REGION_E_G_us-east-1]
AWS_BUCKET_NAME=[YOUR_AWS_BUCKET_NAME_HERE]
AWS_ACCESS_KEY_ID=[YOUR_AWS_ACCESS_KEY_HERE]
AWS_SECRET_ACCESS_KEY=[YOUR_AWS_SECRET_ACCESS_KEY_HERE]

# ------------------------------------------------------------------------------
# 5. EMAIL NOTIFICATIONS (Twilio SendGrid)
# ------------------------------------------------------------------------------
# Your SendGrid API Key starting with 'SG.'
SENDGRID_API_KEY=[YOUR_SENDGRID_API_KEY_HERE]
# The verified sender email address configured in SendGrid
SENDGRID_FROM_EMAIL=[YOUR_VERIFIED_SENDER_EMAIL_HERE]

# ------------------------------------------------------------------------------
# 6. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# Generate these keys once using web-push CLI: `npx web-push generate-vapid-keys`
VAPID_PUBLIC_KEY=[YOUR_VAPID_PUBLIC_KEY_HERE]
VAPID_PRIVATE_KEY=[YOUR_VAPID_PRIVATE_KEY_HERE]
# Contact email included in push notification headers
VAPID_SUBJECT=mailto:[YOUR_CONTACT_EMAIL_HERE]

# ------------------------------------------------------------------------------
# 7. AI INTEGRATIONS (Google Gemini)
# ------------------------------------------------------------------------------
# API Key for the Gemini AI used to summarize academic PDFs
GEMINI_API_KEY=[YOUR_GEMINI_API_KEY_HERE]

# ------------------------------------------------------------------------------
# 8. CRON JOBS
# ------------------------------------------------------------------------------
# Secret token to authorize internal cron jobs if triggered via HTTP
CRON_SECRET=[GENERATE_A_SECURE_RANDOM_STRING_HERE]
