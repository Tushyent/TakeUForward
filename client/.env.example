# ==============================================================================
# 🚀 TakeUForward Frontend - Environment Variables Template
# ==============================================================================
# Instructions:
# 1. Copy this file to `.env` in the client root.
# 2. Never commit your real `.env` file to version control.
# 3. Replace all bracketed placeholder values with your actual secrets.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND API URL
# ------------------------------------------------------------------------------
# NOTE: This is for LOCAL DEVELOPMENT ONLY.
# In production on Vercel, the `vercel.json` file handles reverse proxying 
# (/api -> Render backend), so this variable should NOT be set on Vercel.
VITE_API_URL=http://localhost:5000/api

# ------------------------------------------------------------------------------
# 2. WEB PUSH NOTIFICATIONS (VAPID)
# ------------------------------------------------------------------------------
# This must match the VAPID_PUBLIC_KEY set in the backend environment variables.
# Generate keys via: `npx web-push generate-vapid-keys`
VITE_VAPID_PUBLIC_KEY=[YOUR_VAPID_PUBLIC_KEY_HERE]
