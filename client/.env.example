# Backend API URL — LOCAL DEVELOPMENT ONLY
# In production, API requests go through Vercel's reverse proxy (/api -> Render backend)
# so this variable should NOT be set on Vercel.
VITE_API_URL=http://localhost:5000/api

# Web Push Notifications (VAPID) Public Key
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
